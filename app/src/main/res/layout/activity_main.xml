<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Contenido principal -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/floating_route_labels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginTop="100dp"
            android:layout_marginStart="16dp"
            android:visibility="gone"
            android:background="@color/fondo_boton_2"
            android:elevation="6dp"
            android:layout_gravity="start|top">

            <!-- Etiqueta Segura -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/circle_shape_ruta_segura" />

                <TextView
                    android:id="@+id/label_segura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Segura"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- Etiqueta Insegura -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/circular_red_background" />

                <TextView
                    android:id="@+id/label_insegura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Insegura"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/menu"
            android:contentDescription="Menú"
            android:elevation="4dp"
            android:src="@drawable/ico_barras_write" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/bottom_sheet_include"
            android:visibility="gone"
            layout="@layout/bottom_sheet_layout" />



    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Menú lateral -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/navigation_menu"
        app:headerLayout="@layout/header_navigation_menu"
        app:itemIconTint="@null" />

</androidx.drawerlayout.widget.DrawerLayout>